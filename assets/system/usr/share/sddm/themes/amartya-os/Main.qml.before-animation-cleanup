	import QtQuick
	import QtQuick.Controls
	import QtQuick.Effects
	import SddmComponents


	Rectangle {
	    id: root

	    property var primaryGeometry: screenModel.geometry(screenModel.primary)
		
	    x: primaryGeometry.x
	    y: primaryGeometry.y
	    width: primaryGeometry.width
	    height: primaryGeometry.height

	    color: "black"
	    focus: true
	property string bootQuote: ""
	   property bool unlocked: false
	property bool authenticating: false
	property bool loginFailed: false
	property bool showPassword: false
	property bool capsLockOn: false
property bool loginSuccess: false
property real loginTransition: 0.0
	property bool powerDialogOpen: false
	property string pendingPowerAction: ""

	property int selectedSession: sessionModel.lastIndex >= 0 ? sessionModel.lastIndex : 0
	property int selectedUserIndex: userModel.lastIndex >= 0
		                        ? userModel.lastIndex
		                        : 0
	property string selectedUserIcon: {
	    if (!userModel || userModel.rowCount() <= 0)
		return ""

	    var icon = userModel.data(
		userModel.index(selectedUserIndex, 0),
		260
	    )

	    return icon ? icon.toString() : ""
	}
	property string selectedUsername: {
	    if (!userModel || userModel.rowCount() <= 0)
		return ""

	    return userModel.data(
		userModel.index(selectedUserIndex, 0),
		257
	    ) || ""
	}

	property string selectedRealName: {
	    if (!userModel || userModel.rowCount() <= 0)
		return selectedUsername

	    var name = userModel.data(
		userModel.index(selectedUserIndex, 0),
		258
	    )

	    return name && name.length > 0 ? name : selectedUsername
	}
	    function unlock() {
		if (!unlocked) {
		    unlocked = true
		    password.forceActiveFocus()
		}
	    }
	Component.onCompleted: {
	root.loadWeather()
	    var xhr = new XMLHttpRequest()
	    xhr.open("GET", "file:///run/amartyaos-quote.txt")

	    xhr.onreadystatechange = function() {
		if (xhr.readyState === XMLHttpRequest.DONE) {
		    bootQuote = xhr.responseText.trim()
		}
	    }

	    xhr.send()
	}
function attemptLogin() {
    if (password.text.length === 0 || authenticating || loginAnimating)
        return

    authenticating = true
    loginFailed = false
    loginAnimating = true

    // Save it before animation
    pendingPassword = password.text

    loginTransition.start()
    
}

	    Keys.onPressed: function(event) {
		if (!unlocked) {
		    unlock()
		    event.accepted = true
		}
	    }

