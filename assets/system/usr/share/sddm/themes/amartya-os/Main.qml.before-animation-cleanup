	// ============================================================
	// POWER CONFIRMATION DIALOG
	// IMPORTANT: This is OUTSIDE powerMenu Row
	// ============================================================

	Item {
	    id: powerConfirmationDialog

	    anchors.fill: parent
	    z: 9999

	    visible: root.powerDialogOpen
	    opacity: root.powerDialogOpen ? 1 : 0

	    Behavior on opacity {
		NumberAnimation { duration: 160 }
	    }


	    // ---------------- BACKDROP ----------------

	    Rectangle {
		anchors.fill: parent
		color: "#88000000"
	    }


	    // ---------------- DIALOG CARD ----------------

	    Rectangle {
		id: powerConfirmationCard

		anchors.centerIn: parent

		width: 420
		height: 220
		radius: 26

		color: "#E61A1A1D"

		border.width: 1
		border.color: "#35ffffff"


		Column {
		    anchors.centerIn: parent
		    spacing: 22


		    // TITLE

		    Text {
		        anchors.horizontalCenter: parent.horizontalCenter

		        text: {
		            if (root.pendingPowerAction === "restart")
		                return "Restart Amartya OS?"

		            if (root.pendingPowerAction === "sleep")
		                return "Put Amartya OS to sleep?"

		            return "Shut down Amartya OS?"
		        }

		        color: "white"
		        font.pixelSize: 22
		        font.weight: Font.Bold
		    }


		    // DESCRIPTION

		    Text {
		        anchors.horizontalCenter: parent.horizontalCenter

		        width: 330

		        text: {
		            if (root.pendingPowerAction === "restart")
		                return "The computer will restart."

		            if (root.pendingPowerAction === "sleep")
		                return "The computer will enter sleep mode."

		            return "The computer will shut down."
		        }

		        color: "#99ffffff"
		        font.pixelSize: 13

		        horizontalAlignment: Text.AlignHCenter
		        wrapMode: Text.WordWrap
		    }


		    // BUTTONS

		    Row {
		        anchors.horizontalCenter: parent.horizontalCenter
		        spacing: 14


		        // ---------------- CANCEL ----------------

		        Rectangle {
		            width: 150
		            height: 46
		            radius: 23

		            color: cancelPowerMouse.containsMouse
		                   ? "#35ffffff"
		                   : "#20ffffff"

		            border.width: 1
		            border.color: "#30ffffff"

		            Text {
		                anchors.centerIn: parent

		                text: "Cancel"
		                color: "white"

		                font.pixelSize: 14
		                font.weight: Font.DemiBold
		            }

		            MouseArea {
		                id: cancelPowerMouse

		                anchors.fill: parent

		                hoverEnabled: true
		                cursorShape: Qt.PointingHandCursor

		                onClicked: {
		                    root.powerDialogOpen = false
		                    root.pendingPowerAction = ""
		                }
		            }
		        }


		        // ---------------- CONFIRM ----------------

		        Rectangle {
		            width: 150
		            height: 46
		            radius: 23

		            color: confirmPowerMouse.containsMouse
		                   ? "#ff6259"
		                   : "#ff453a"

		            Text {
		                anchors.centerIn: parent

		                text: {
		                    if (root.pendingPowerAction === "restart")
		                        return "Restart"

		                    if (root.pendingPowerAction === "sleep")
		                        return "Sleep"

		                    return "Shut Down"
		                }

		                color: "white"

		                font.pixelSize: 14
		                font.weight: Font.Bold
		            }

		            MouseArea {
		                id: confirmPowerMouse

		                anchors.fill: parent

		                hoverEnabled: true
		                cursorShape: Qt.PointingHandCursor

		                onClicked: {

		                    var action = root.pendingPowerAction

		                    // Close dialog first
		                    root.powerDialogOpen = false
		                    root.pendingPowerAction = ""

		                    // Execute requested action
		                    if (action === "sleep") {
		                        sddm.suspend()
		                    }
		                    else if (action === "restart") {
		                        sddm.reboot()
		                    }
		                    else if (action === "power") {
		                        sddm.powerOff()
		                    }
		                }
		            }
		        }
		    }
		}
	    }
	}


	// ============================================================
	// SESSION SELECTOR
	// ============================================================
	    // ============================================================
	    // SESSION SELECTOR
	    // ============================================================

	    Item {
		id: sessionArea

		anchors.top: parent.top
		anchors.left: parent.left
		anchors.topMargin: 30
		anchors.leftMargin: 30

		width: 230
		height: sessionPopup.visible ? 300 : 42

		opacity: root.unlocked ? 1 : 0
		visible: opacity > 0

		property bool open: false

		Behavior on opacity {
		    NumberAnimation { duration: 500 }
		}

		// Main session pill
		Rectangle {
		    id: sessionPill

		    width: 210
		    height: 42
		    radius: 21

		    color: sessionMouse.containsMouse
		           ? "#50191919"
		           : "#30191919"

		    border.width: 1
		    border.color: "#30ffffff"

		    Row {
		        anchors.fill: parent
		        anchors.leftMargin: 16
		        anchors.rightMargin: 14
		        spacing: 9

		        Text {
		            anchors.verticalCenter: parent.verticalCenter
		            text: "◈"
		            color: "white"
		            opacity: 0.85
		            font.pixelSize: 15
		        }

		        Text {
		            id: selectedSessionText

		            anchors.verticalCenter: parent.verticalCenter

		            width: 140

		            text: {
		                if (!sessionModel || sessionModel.rowCount() <= 0)
		                    return "Desktop"

		                var i = root.selectedSession

		                if (i < 0 || i >= sessionModel.rowCount())
		                    i = 0

		                var n = sessionModel.data(
		                            sessionModel.index(i, 0), 260)

		                return n ? n : "Desktop"
		            }

		            color: "white"
		            font.pixelSize: 13
		            font.weight: Font.DemiBold

		            elide: Text.ElideRight
		        }

		        Text {
		            anchors.verticalCenter: parent.verticalCenter
		            text: sessionArea.open ? "⌃" : "⌄"
		            color: "#bbffffff"
		            font.pixelSize: 14
		        }
		    }

		    MouseArea {
		        id: sessionMouse
		        anchors.fill: parent

		        hoverEnabled: true
		        cursorShape: Qt.PointingHandCursor

		        onClicked: sessionArea.open = !sessionArea.open
		    }
		}


		// Session popup
		Rectangle {
		    id: sessionPopup

		    anchors.top: sessionPill.bottom
		    anchors.topMargin: 10

		    width: 230

		    height: {
		        var count = sessionModel ? sessionModel.rowCount() : 0
		        return Math.min(count * 48 + 16, 250)
		    }

		    radius: 22

		    visible: sessionArea.open
		    opacity: sessionArea.open ? 1 : 0

		    color: "#CC191919"

		    border.width: 1
		    border.color: "#35ffffff"

		    clip: true

		    Behavior on opacity {
		        NumberAnimation { duration: 160 }
		    }

		    ListView {
		        id: sessionList

		        anchors.fill: parent
		        anchors.margins: 8

		        clip: true
		        spacing: 2

		        model: sessionModel
		        currentIndex: root.selectedSession

		        delegate: Rectangle {
		            required property int index

		            width: sessionList.width
		            height: 46
		            radius: 14

		            property bool selected:
		                index === root.selectedSession

		            color: selected
		                   ? "#35ffffff"
		                   : sessionDelegateMouse.containsMouse
		                     ? "#20ffffff"
		                     : "transparent"

		            Text {
		                anchors.left: parent.left
		                anchors.leftMargin: 14
		                anchors.verticalCenter: parent.verticalCenter

		                width: parent.width - 45

		                text: {
		                    var n = sessionModel.data(
		                                sessionModel.index(index, 0), 260)

		                    return n ? n : "Session"
		                }

		                color: "white"
		                font.pixelSize: 13
		                font.weight: parent.selected
		                             ? Font.Bold
		                             : Font.Normal

		                elide: Text.ElideRight
		            }

		            Text {
		                anchors.right: parent.right
		                anchors.rightMargin: 14
		                anchors.verticalCenter: parent.verticalCenter

		                visible: parent.selected

		                text: "✓"
		                color: "#5ac8fa"
		                font.pixelSize: 14
		                font.weight: Font.Bold
		            }

		            MouseArea {
		                id: sessionDelegateMouse
		                anchors.fill: parent

		                hoverEnabled: true
		                cursorShape: Qt.PointingHandCursor

		                onClicked: {
		                    root.selectedSession = index
		                    sessionList.currentIndex = index
		                    sessionArea.open = false
		                }
		            }
		        }
		    }
		}
	    }
	    // ============================================================
	    
	    // ============================================================
	    // CLOCK
	    // ============================================================

	    Timer {
		interval: 1000
		running: true
		repeat: true

		triggeredOnStart: true

		onTriggered: {
		    var now = new Date()

		    lockTime.text =
		        Qt.formatTime(now, "HH:mm")

		    lockDate.text =
		        Qt.formatDate(now, "dddd, MMMM d")
		}
	    }
	    

	    // ============================================================
	    // SDDM AUTH RESULT
	    // ============================================================

	    Connections {
	    target: sddm

	    function onLoginFailed() {
		root.authenticating = false
		root.loginFailed = true

		password.clear()
		password.forceActiveFocus()

		if (passwordShake.running)
		    passwordShake.stop()

		passwordShake.start()
	    }
	}
	SequentialAnimation {
    id: loginTransition

    // Small pause so button press feels responsive
    PauseAnimation {
        duration: 80
    }

    // Fade login UI
    NumberAnimation {
        target: loginPanel
        property: "opacity"
        to: 0
        duration: 280
        easing.type: Easing.InOutCubic
    }

    // Then authenticate
    ScriptAction {
        script: {
            sddm.login(
                root.selectedUsername,
                root.pendingPassword,
                root.selectedSession
            )
        }
    }
}
	}

